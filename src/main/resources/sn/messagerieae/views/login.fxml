<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20"
      prefWidth="400" prefHeight="500"
      styleClass="login-container"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="sn.messagerieae.controller.LoginController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
    <Label text="Messagerie AE" styleClass="app-title"/>
    <Label text="Connectez-vous à votre compte" styleClass="subtitle"/>
    <VBox spacing="12" maxWidth="300">
        <Label text="Nom d'utilisateur" styleClass="field-label"/>
        <TextField fx:id="usernameField"
                   promptText="Entrez votre username"
                   styleClass="input-field"/>
        <Label text="Mot de passe" styleClass="field-label"/>
        <PasswordField fx:id="passwordField"
                       promptText="Entrez votre mot de passe"
                       styleClass="input-field"/>
        <Label fx:id="errorLabel" styleClass="error-label"
               visible="false" managed="false"/>
        <Button text="Se connecter"
                onAction="#handleLogin"
                styleClass="btn-primary"
                maxWidth="Infinity"/>
    </VBox>
    <HBox alignment="CENTER" spacing="5">
        <Label text="Pas encore de compte ?"/>
        <Hyperlink text="S'inscrire"
                   onAction="#goToRegister"
                   styleClass="link"/>
    </HBox>
</VBox>
