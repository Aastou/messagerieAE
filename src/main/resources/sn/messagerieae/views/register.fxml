<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20"
      prefWidth="400" prefHeight="550"
      styleClass="login-container"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="sn.messagerieae.controller.RegisterController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
    <Label text="Créer un compte" styleClass="app-title"/>
    <Label text="Rejoignez l'association" styleClass="subtitle"/>
    <VBox spacing="12" maxWidth="300">
        <Label text="Nom d'utilisateur" styleClass="field-label"/>
        <TextField fx:id="usernameField"
                   promptText="Choisissez un username"
                   styleClass="input-field"/>
        <Label text="Mot de passe" styleClass="field-label"/>
        <PasswordField fx:id="passwordField"
                       promptText="Minimum 4 caractères"
                       styleClass="input-field"/>
        <Label text="Confirmer le mot de passe" styleClass="field-label"/>
        <PasswordField fx:id="confirmPasswordField"
                       promptText="Retapez le mot de passe"
                       styleClass="input-field"/>
        <Label text="Rôle" styleClass="field-label"/>
        <ComboBox fx:id="roleComboBox"
                  promptText="Sélectionnez un rôle"
                  maxWidth="Infinity"
                  styleClass="input-field"/>
        <Label fx:id="errorLabel" styleClass="error-label"
               visible="false" managed="false"/>
        <Label fx:id="successLabel" styleClass="success-label"
               visible="false" managed="false"/>
        <Button text="S'inscrire"
                onAction="#handleRegister"
                styleClass="btn-primary"
                maxWidth="Infinity"/>
    </VBox>
    <HBox alignment="CENTER" spacing="5">
        <Label text="Déjà un compte ?"/>
        <Hyperlink text="Se connecter"
                   onAction="#goToLogin"
                   styleClass="link"/>
    </HBox>
</VBox>
